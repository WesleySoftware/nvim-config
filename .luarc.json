{
    "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
    "runtime": {
        "version": "LuaJIT"
    },
    "diagnostics": {
        "globals": [
            "vim"
        ]
    },
    "workspace": {
        "library": [
            "~/.local/share/nvim/runtime",
            "~/.config/nvim"
        ],
        "checkThirdParty": false
    },
    "telemetry": {
        "enable": false
    }
}